  "firestore": {
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public seller and buyer display profiles without PII."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only private profile documents containing email, WhatsApp number, exact location, and preferences."
    },
    "/users/{userId}/paymentMethods/{methodId}": {
      "schema": { "$ref": "#/entities/PaymentMethod" },
      "description": "Owner-only masked payment instruments (Bank Card, MTN MoMo, Orange Money)."
    },
    "/users/{userId}/favorites/{listingId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "Owner-only bookmarked second-hand listings."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Publicly browsable second-hand listings with detailed description, specs, and pickup area."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Private 1-to-1 negotiation and messaging threads restricted to buyerId and sellerId."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Immutable chat messages and offers belonging to a specific buyer-seller conversation."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Peer-to-peer transaction receipts restricted to the buyer and seller."
    }
  }
}
