        "status": {
          "type": "string",
          "enum": ["open", "closed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "listingId",
        "listingTitle",
        "listingPrice",
        "currency",
        "listingImageUrl",
        "buyerId",
        "buyerName",
        "buyerWhatsapp",
        "buyerLocation",
        "sellerId",
        "sellerName",
        "sellerWhatsapp",
        "sellerLocation",
        "lastMessage",
        "lastSenderId",
        "offerPrice",
        "offerStatus",
        "unreadByBuyer",
        "unreadBySeller",
        "status",
        "createdAt",
        "updatedAt"
