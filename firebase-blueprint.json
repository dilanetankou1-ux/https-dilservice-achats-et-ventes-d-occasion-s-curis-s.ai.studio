        },
        "sellerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sellerWhatsapp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "sellerLocation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "lastMessage": {
          "type": "string",
          "minLength": 0,
