{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly visible profile details for marketplace participants without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "city", "photoURL", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile containing PII, exact location, WhatsApp contact, and currency preferences, strictly owner-readable and owner-writable.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "country": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "city": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "neighborhood": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "continent": {
          "type": "string",
          "enum": ["afrique", "europe", "ameriques", "asie_oceanie"]
        },
        "preferredCurrency": {
          "type": "string",
          "enum": ["EUR", "XAF", "XOF", "MAD", "NGN", "KES", "ZAR", "GBP", "CHF", "USD", "CAD"]
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "whatsappNumber": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "country",
        "city",
        "neighborhood",
        "continent",
        "preferredCurrency",
        "phone",
        "whatsappNumber",
        "photoURL",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Owner-only tokenized/masked payment instrument (Bank Card, MTN MoMo, or Orange Money). Never stores raw PAN or CVV.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "provider": {
          "type": "string",
          "enum": ["carte_bancaire", "mtn_momo", "orange_money"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "holderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "maskedIdentifier": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "cardBrand": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "expiry": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "countryDialCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "isDefault": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "provider",
        "label",
        "holderName",
        "maskedIdentifier",
        "cardBrand",
        "expiry",
        "countryDialCode",
        "isDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "A user's saved second-hand listing bookmark.",
